# Adapter selection
VITE_COMMERCE_PLATFORM=mock
VITE_API_BASE_URL=
VITE_AUTH_PROVIDER=commerce

# Locale / currency defaults
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_CURRENCY=USD

# Feature flags
VITE_ENABLE_QUOTES=true
VITE_ENABLE_APPROVALS=false
VITE_ENABLE_COMPANY_MANAGEMENT=true
VITE_ENABLE_SHOPPING_LISTS=true
VITE_ENABLE_INVOICES=false

# BigCommerce adapter (only required when VITE_COMMERCE_PLATFORM=bigcommerce)
VITE_BC_B2B_API_URL=
VITE_BC_B2B_APP_CLIENT_ID=
VITE_BC_STORE_HASH=
VITE_BC_CHANNEL_ID=
VITE_BC_STOREFRONT_URL=
