# See docs/ENVIRONMENT.md.
# This is a top-level reference. Each workspace also has its own
# apps/portal/.env.example and apps/server/.env.example.

# apps/server
PORT=8787
PUBLIC_PORTAL_URL=http://localhost:3000
SESSION_SIGNING_KEY=replace-with-32+byte-random-secret
DATABASE_URL=postgres://b2b:b2b@localhost:5432/b2b_portal
SHOPIFY_SHOP_DOMAIN=acme.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2024-10
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2024-10
SHOPIFY_CAA_CLIENT_ID=
SHOPIFY_CAA_CLIENT_SECRET=
SHOPIFY_CAA_REDIRECT_URI=http://localhost:3000/auth/callback
FEATURE_QUOTES=true
FEATURE_APPROVALS=false
FEATURE_SHOPPING_LISTS=true
FEATURE_INVOICES=false
FEATURE_MULTI_TIER_HIERARCHY=false

# apps/portal
VITE_BFF_URL=/api
VITE_DEFAULT_LOCALE=en-US
VITE_DEFAULT_CURRENCY=USD
VITE_ENABLE_QUOTES=true
VITE_ENABLE_APPROVALS=false
VITE_ENABLE_SHOPPING_LISTS=true
VITE_ENABLE_INVOICES=false
