# Server
NODE_ENV=development
PORT=3000

# Shopify store identity
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Admin API — client credentials grant (as of Jan 2026, no static access tokens issued for new apps)
SHOPIFY_CLIENT_ID=your_app_client_id
SHOPIFY_CLIENT_SECRET=your_app_client_secret

# Storefront API — static token (unaffected by admin auth change)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token

# Customer Account API OAuth (unrelated to admin credentials above)
SHOPIFY_CAA_CLIENT_ID=your_caa_client_id
SHOPIFY_CAA_CLIENT_SECRET=your_caa_client_secret
